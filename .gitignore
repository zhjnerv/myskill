# ---- Google Drive 同步产物 ----
desktop.ini
.tmp.drivedownload/
.tmp.driveupload/
*.gdoc
*.gsheet

# ---- Windows / macOS 系统文件 ----
Thumbs.db
ehthumbs.db
.DS_Store

# ---- skill-manager 等工具的备份残留 ----
*.backup
*.backup/
*.bak
*.orig
*.rej

# ---- 本地运行期产物 ----
__pycache__/
*.pyc
*.pyo
# 上游镜像克隆默认落在 %LOCALAPPDATA%\myskill-upstream，不在仓库内；
# 若用 -CacheRoot 覆盖到仓库内，这条兜底防止误提交
.upstream/

# ---- 各 Agent 的本地配置目录（本仓库是 skill 源，不承载 Agent 配置） ----
.claude/
.codex/
.openclaw/
.qoderworkcn/

# ---- 编辑器 ----
.vscode/
.idea/

# ---- Skill local credentials ----
skills/**/config/.env

# ---- Playwright MCP 运行日志 ----
.playwright-mcp/
