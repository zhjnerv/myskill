# 全仓库强制 LF。
# 原因：本仓库通过 git subtree 与上游仓库双向同步，上游几乎都在 Linux/macOS 上维护。
# 若工作区出现 CRLF，subtree pull 会把整文件判定为改动，制造大量伪冲突。
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.db    binary

# 脚本必须是 LF，否则在 Git Bash / WSL 下会报 `bad interpreter: no such file`
*.sh text eol=lf
*.py text eol=lf

# PowerShell 脚本同样用 LF（Windows PowerShell 5.1 与 pwsh 均可正确解析 LF）
*.ps1 text eol=lf

# 让 GitHub 语言统计忽略 vendored 的上游 skill，避免统计被上游代码带偏
skills/** linguist-vendored
