{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cn-patent-workflow-plan/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "case_id", "objective", "profile", "created_at", "updated_at", "steps"],
  "properties": {
    "schema_id": {"const": "cn-patent-workflow-plan/v1"},
    "case_id": {"type": "string"},
    "objective": {"type": "string"},
    "profile": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "skill", "optional", "status", "note", "outputs", "started_at", "finished_at"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "skill": {"type": "string"},
          "optional": {"type": "boolean"},
          "status": {"enum": ["pending", "running", "done", "skipped", "waiting", "blocked"]},
          "note": {"type": "string"},
          "outputs": {"type": "array", "items": {"type": "string"}},
          "started_at": {"type": ["string", "null"]},
          "finished_at": {"type": ["string", "null"]}
        }
      }
    }
  }
}
