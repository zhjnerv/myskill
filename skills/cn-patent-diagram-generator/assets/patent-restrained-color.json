{
  "name": "patent_restrained_color",
  "purpose": "中国专利说明书附图的克制彩色方案",
  "background": "#FFFFFF",
  "fontColor": "#111111",
  "edgeColor": "#202020",
  "roles": {
    "primary": {
      "fillColor": "#EAF2F8",
      "strokeColor": "#405F73"
    },
    "secondary": {
      "fillColor": "#EEF4EA",
      "strokeColor": "#52634E"
    },
    "decision": {
      "fillColor": "#F8F2E6",
      "strokeColor": "#706347"
    },
    "neutral": {
      "fillColor": "#F4F4F4",
      "strokeColor": "#4A4A4A"
    },
    "external": {
      "fillColor": "#FFFFFF",
      "strokeColor": "#666666",
      "dashed": true
    }
  },
  "rules": {
    "maximum_nonwhite_fills_per_figure": 3,
    "gradients": false,
    "shadows": false,
    "transparency": false,
    "dark_background": false,
    "color_must_not_be_only_semantic_carrier": true
  },
  "typography": {
    "fontFamily": "Noto Sans CJK SC, Microsoft YaHei, Arial, sans-serif",
    "primaryFontSize": 15,
    "annotationFontSize": 13,
    "minimumFontSize": 12,
    "fontColor": "#111111",
    "maximumChineseCharactersPerLine": 12
  },
  "geometry": {
    "grid": 10,
    "defaultNodeWidth": 200,
    "defaultNodeHeight": 70,
    "minimumHorizontalGap": 80,
    "routingCorridor": 80,
    "pageMargin": 40,
    "maximumFrameToTextHeightRatio": 2,
    "maximumVerticalBlankToSmallerNodeHeightRatio": 0.5,
    "subtractNativeEdgeLabelTextHeight": true
  },
  "connectors": {
    "edgeStyle": "orthogonalEdgeStyle",
    "rounded": false,
    "strokeWidth": 1.4,
    "endArrow": "blockThin",
    "singleDirectEdge": true,
    "nativeEdgeLabels": true,
    "separateLabelNodes": false
  }
}
